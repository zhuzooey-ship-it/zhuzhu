{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/release-manifest.schema.json",
  "title": "Userscript Governance Release Manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "generatedAt",
    "sourceFiles",
    "symbols",
    "dependencies",
    "contracts",
    "optimizations",
    "features",
