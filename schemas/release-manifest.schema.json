    },
    "generatedAt": {
      "type": "string"
    },
    "sourceFiles": {
      "type": "array"
    },
    "symbols": {
      "type": "array"
    },
    "dependencies": {
      "type": "array"
    },
    "contracts": {
      "type": "array"
    },
    "optimizations": {
      "type": "array"
    },
    "summary": {
      "type": "object"
    },
    "features": {
      "type": "array"
    },
    "tests": {
      "type": "array"
    },
    "roadmap": {
      "type": "array"
    }
  }
}
